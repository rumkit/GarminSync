<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GarminSync.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GarminSync.Maui"
    Shell.FlyoutBehavior="Flyout"
    Title="GarminSync.Maui">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    
    <ShellContent
        Title="Steps"
        ContentTemplate="{DataTemplate local:GetStepsPage}"
        Route="GetStepsPage" />

</Shell>
